{
  "name": "process-legal-pack",
  "version": "1.0.0",
  "description": "Backend service for processing legal pack PDFs with OpenAI analysis",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "node -r ts-node/register --test src/__tests__/**/*.test.ts"
  },
  "keywords": [
    "pdf",
    "legal",
    "openai",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mendable/firecrawl-js": "^1.0.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.1",
    "mammoth": "^1.6.0",
    "openai": "^4.20.0",
    "p-limit": "^3.1.0",
    "pdf-parse": "^1.1.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
